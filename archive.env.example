# New installation example. On upgrade, KEEP existing paths and authentication.
REELSHRINK_IMAGE=ghcr.io/kirederb-vibing/reelshrink:latest
PUID=1000
PGID=1000
TZ=Europe/Copenhagen
CONFIG_PATH=/srv/reelshrink/config
WORK_PATH=/srv/reelshrink/work
WORK_DRIVE_TYPE=local

# These are existing host mountpoints, not SMB/NFS URLs.
FILM_PATH=/mnt/media/film
FILM_DRIVE_TYPE=network
FILM2_PATH=/mnt/media/film_2
FILM2_DRIVE_TYPE=network
SERIES_PATH=/mnt/media/serier
SERIES_DRIVE_TYPE=network

ENCODE_THREADS=2
SCAN_INTERVAL=30
STABLE_SECONDS=60
MIN_FREE_GB=2

# Set BOTH for a new install; preserve existing secret values on upgrade.
AUTH_USERNAME=
AUTH_PASSWORD=
