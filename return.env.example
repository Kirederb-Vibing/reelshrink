REELSHRINK_IMAGE=ghcr.io/kirederb-vibing/reelshrink:latest
PUID=1000
PGID=1000
TZ=Europe/Copenhagen
# Reuse the current database location. Do not start with an empty /config.
CONFIG_PATH=/srv/reelshrink/config
OUTPUT_PATH=/srv/reelshrink/encoded
MOVIES_PATH=/srv/media/movies
MOVIES_2_PATH=/srv/media/movies_2
SERIES_PATH=/srv/media/series
INCOMING_PATH=/srv/reelshrink/incoming
# Set these to the EXISTING container paths shown in your job details.
# Example: if your old jobs use /media/film, use /media/film here too.
MOVIES_CONTAINER_PATH=/media/movies
MOVIES_2_CONTAINER_PATH=/media/movies_2
SERIES_CONTAINER_PATH=/media/series
ENCODE_THREADS=2
SCAN_INTERVAL=30
STABLE_SECONDS=60
MIN_FREE_GB=2
AUTH_USERNAME=
AUTH_PASSWORD=
