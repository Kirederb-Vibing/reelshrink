# After publishing, use the image name shown under GitHub Packages (lowercase).
REELSHRINK_IMAGE=ghcr.io/kirederb-vibing/reelshrink:latest
PUID=1000
PGID=1000
TZ=Europe/Copenhagen
CONFIG_PATH=./config
OUTPUT_PATH=./output
MOVIES_PATH=./media/movies
SERIES_PATH=./media/series
# Used only by compose.yaml. compose.proxy.yaml exposes no host port.
WEB_BIND=0.0.0.0
WEB_PORT=8080
ENCODE_THREADS=2
SCAN_INTERVAL=30
STABLE_SECONDS=60
MIN_FREE_GB=2
# Set both to enable browser HTTP Basic authentication. Use HTTPS at the proxy.
# Quote passwords containing $ with single quotes to prevent Compose interpolation.
AUTH_USERNAME=
AUTH_PASSWORD=
